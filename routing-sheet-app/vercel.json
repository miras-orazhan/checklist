{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "version": 2,
  "installCommand": "pnpm install --frozen-lockfile",
  "buildCommand": "pnpm --filter @workspace/routing-sheet run build",
  "outputDirectory": "artifacts/routing-sheet/dist/public",
  "functions": {
    "api/**/*.ts": {
      "maxDuration": 30,
      "memory": 1024
    }
  },
  "routes": [
    {
      "src": "/api/(.*)",
      "dest": "/api/$1"
    },
    {
      "src": "/photos/(.*)",
      "dest": "/api/photos/$1"
    },
    {
      "src": "/((?!api).*)",
      "dest": "/index.html"
    }
  ]
}
