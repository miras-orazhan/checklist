# PGlite in-process database (no external Postgres needed)
DATABASE_URL=file:/home/z/my-project/db/routing-sheet-pglite

# JWT session secret (any random string)
SESSION_SECRET=dev-secret-routing-sheet-pglite-0123456789

# API server port
PORT=5000

# Public base URL of the frontend (used for links in emails)
# Override per-deploy via env. Used only if `app_base_url` is not set in DB.
PUBLIC_BASE_URL=https://preview-zai-web.space-z.ai

# Email (Gmail via Google Apps Script) — left empty → adapter logs to console
GAS_WEBHOOK_URL=

# Bitrix24 — left empty → adapter logs to console
BITRIX24_WEBHOOK_URL=

# Vite frontend env
VITE_API_URL=http://127.0.0.1:5000
