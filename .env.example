# ============================================================================
# Environment Variables — copy this file to .env and fill in real values
# ============================================================================

# ─── Database ────────────────────────────────────────────────────────────────
# Production: Neon Postgres connection string
#   Get it from https://neon.tech → your project → Connection string
#   Format: postgresql://user:password@host/dbname?sslmode=require
#
# Development: leave empty to use PGlite (in-process, no external DB needed)
DATABASE_URL=

# ─── Security ────────────────────────────────────────────────────────────────
# JWT secret for signing auth tokens — generate a random 32+ char string
#   Run: openssl rand -hex 32
SESSION_SECRET=

# ─── Server ──────────────────────────────────────────────────────────────────
# Port for API server (dev only — Vercel ignores this)
PORT=5000

# Public base URL of the frontend (used for links in emails)
#   Production: https://your-app.vercel.app
#   Dev: http://localhost:3000
PUBLIC_BASE_URL=

# ─── Email (Gmail via Google Apps Script) ────────────────────────────────────
# Deploy a Google Apps Script web app that sends email via Gmail.
#   See: docs/EMAIL_SETUP.md
# Leave empty in dev → emails are logged to console instead of sent
GAS_WEBHOOK_URL=
GAS_WEBHOOK_SECRET=

# ─── Bitrix24 ────────────────────────────────────────────────────────────────
# REST API webhook URL for account creation/revocation
# Leave empty in dev → calls are logged to console
BITRIX24_REST_URL=
BITRIX24_RESPONSIBLE_ID=

# ─── Photo Storage (production) ──────────────────────────────────────────────
# Vercel Blob store token (for production photo uploads)
#   Get it from Vercel dashboard → Storage → Blob → Create store
# Leave empty in dev → photos stored locally in /home/z/my-project/db/photos
BLOB_READ_WRITE_TOKEN=

# ─── Frontend (Vite) ─────────────────────────────────────────────────────────
# API base URL for frontend requests
#   Production: empty (same origin, /api/* proxied by Vercel)
#   Dev: http://127.0.0.1:5000
VITE_API_URL=
